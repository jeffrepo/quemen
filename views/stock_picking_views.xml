<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- STOCK PICKING FORM -->
    <record model="ir.ui.view" id="quemen_view_picking_form">
        <field name="name">quemen.stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <field name="is_locked" position="after">
                <field name="generar_nuevos_lotes" invisible="1"/>
            </field>

            <field name="origin" position="after">
                <field name="dia_congelamiento"/>
            </field>

            <page name="extra" position="before">
                <!-- Odoo 19: sin attrs/states. Usa invisible="" -->
                <page string="Productos" name="productos" invisible="not generar_nuevos_lotes">
                    <field name="producto_ids" mode="list">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="lote_id" domain="[('product_id','=',product_id)]"/>
                            <field name="cantidad"/>
                        </list>
                    </field>
                </page>
            </page>

        </field>
    </record>

    <!-- PICKING TYPE FORM -->
    <record model="ir.ui.view" id="quemen_view_picking_type_form">
        <field name="name">Quemen Operation Types</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <field name="warehouse_id" position="after">
                <group string="Quemen extras">
                    <field name="tipo_operacion_caducidad_id"/>
                    <field name="tipo_operacion_porcion_id"/>
                    <field name="picking_partner_id"/>
                    <field name="tipo_transporte"/>
                    <field name="salida_traspaso"/>
                    <field name="generar_nuevos_lotes"/>
                    <field name="bloqueo_traspaso"/>
                    <field name="generar_nuevos_lotes_tiendas"/>
                </group>
            </field>
        </field>
    </record>

    <!-- STOCK QUANT LIST EDITABLE -->
    <record model="ir.ui.view" id="view_stock_quant_list_editable_quemen">
        <field name="name">stock.quant.list.editable.quemen</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">

            <field name="product_id" position="before">
                <field name="referencia_interna"/>
            </field>

            <!-- Odoo 19: NO attrs/states. Y NO use_expiration_date (no existe en stock.quant). -->
            <xpath expr="//field[@name='inventory_diff_quantity']" position="before">
                <field name="expiration_date"
                       optional="show"
                       invisible="context.get('removal_date')"/>
            </xpath>

        </field>
    </record>

    <!-- STOCK MOVE LINE DETAILED OPERATION LIST -->
    <record model="ir.ui.view" id="quemen_stock_move_line_detailed_operation_list">
        <field name="name">stock.move.line.detailded.operation.list</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree_detailed"/>
        <field name="arch" type="xml">
            <field name="product_id" position="before">
                <field name="barcode"/>
            </field>
        </field>
    </record>

</odoo>
