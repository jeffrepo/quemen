<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- =========================
         RELOJ CHECADOR
    ========================== -->

    <record id="view_quemen_reloj_checador_list" model="ir.ui.view">
      <field name="name">quemen.reloj_checador.list</field>
      <field name="model">quemen.reloj_checador</field>
      <field name="arch" type="xml">
        <list string="Reloj checador">
          <field name="ac"/>
          <field name="empleado_id"/>
          <field name="departamento_id"/>
          <field name="area_id"/>
          <field name="puesto_id"/>
          <field name="dia"/>
          <field name="fecha"/>
          <field name="hora_entrada" widget="float_time"/>
          <field name="hora_salida" widget="float_time"/>
          <field name="horas_laboradas" widget="float_time"/>
          <field name="jornada_laborada" widget="float_time"/>
          <field name="horas_extras_laboradas" widget="float_time"/>
        </list>
      </field>
    </record>

    <record id="view_quemen_reloj_checador_form" model="ir.ui.view">
      <field name="name">quemen.reloj_checador.form</field>
      <field name="model">quemen.reloj_checador</field>
      <field name="arch" type="xml">
        <form string="Reloj checador">
          <sheet>
            <group>
              <group>
                <field name="empleado_id"/>
                <field name="fecha"/>
              </group>
              <group>
                <field name="hora_entrada" widget="float_time"/>
                <field name="hora_salida" widget="float_time"/>
              </group>
            </group>
          </sheet>

          <div class="o_attachment_preview"/>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
            <field name="activity_ids" widget="mail_activity"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>
        </form>
      </field>
    </record>

    <record id="quemen_reloj_checador_view_search" model="ir.ui.view">
      <field name="name">quemen.reloj_checador.search</field>
      <field name="model">quemen.reloj_checador</field>
      <field name="arch" type="xml">
        <search string="Buscar empleado">
          <field name="empleado_id"/>
          <field name="fecha"/>
          <field name="hora_entrada"/>
          <field name="hora_salida"/>
        </search>
      </field>
    </record>

    <record id="action_quemen_reloj_checador_administrativa" model="ir.actions.act_window">
      <field name="name">Reloj checador</field>
      <field name="res_model">quemen.reloj_checador</field>
      <field name="view_mode">list,form</field>
      <field name="domain"></field>
      <field name="context"></field>
      <field name="search_view_id" ref="quemen_reloj_checador_view_search"/>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">
          Click para crear una nueva entrada
        </p>
      </field>
    </record>

    <menuitem
      id="menu_quemen_reloj_checador"
      name="Reloj checador"
      action="action_quemen_reloj_checador_administrativa"
      parent="hr.menu_hr_employee_payroll"
      sequence="75"
    />

    <!-- =========================
         RETIROS POS
    ========================== -->

    <record id="view_quemen_retiros_list" model="ir.ui.view">
      <field name="name">quemen.retiros.list</field>
      <field name="model">quemen.retiros_efectivo</field>
      <field name="arch" type="xml">
        <list string="Retiros POS">
          <field name="name"/>
          <field name="cajero"/>
          <field name="tienda_id"/>
          <field name="sesion_id"/>
          <field name="fecha_hora"/>
          <field name="usuario_id"/>
          <field name="motivo"/>
          <field name="total"/>
        </list>
      </field>
    </record>

    <record id="view_quemen_retiros_form" model="ir.ui.view">
      <field name="name">quemen.retiros.form</field>
      <field name="model">quemen.retiros_efectivo</field>
      <field name="arch" type="xml">
        <form string="Retiros">
          <header>
            <button name="confirmar_retiro"
                    string="Confirmar"
                    type="object"
                    class="oe_highlight"
                    invisible="state != 'borrador'"/>
            <field name="state" widget="statusbar" statusbar_visible="borrador,confirmado"/>
          </header>

          <sheet>
            <div class="oe_title">
              <h1><field name="name" readonly="1"/></h1>
            </div>

            <group>
              <group>
                <field name="sesion_id"/>
                <field name="motivo"/>
                <field name="usuario_id"/>
                <field name="cajero"/>
              </group>
              <group>
                <field name="fecha_hora"/>
                <field name="total"/>
                <field name="entregado"/>
                <field name="ultimo_retiro"/>
              </group>
            </group>

            <notebook>
              <page string="Denominaciones" name="denominaciones">
                <field name="denominacion_ids">
                  <list editable="bottom">
                    <field name="denominacion_id"/>
                    <field name="cantidad"/>
                  </list>
                </field>
              </page>
            </notebook>

          </sheet>
        </form>
      </field>
    </record>

    <record id="quemen_retiros_view_search" model="ir.ui.view">
      <field name="name">quemen.retiros.search</field>
      <field name="model">quemen.retiros_efectivo</field>
      <field name="arch" type="xml">
        <search string="Retiros">
          <field name="name"/>
        </search>
      </field>
    </record>

    <record id="action_quemen_retiros" model="ir.actions.act_window">
      <field name="name">Retiros POS</field>
      <field name="res_model">quemen.retiros_efectivo</field>
      <field name="view_mode">list,form</field>
      <field name="domain"></field>
      <field name="context"></field>
      <field name="search_view_id" ref="quemen_retiros_view_search"/>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">
          Click para crear un retiro
        </p>
      </field>
    </record>

    <!-- =========================
         PROMOCIONES
    ========================== -->

    <record id="view_quemen_promociones_form" model="ir.ui.view">
      <field name="name">quemen.promociones.form</field>
      <field name="model">quemen.promociones</field>
      <field name="arch" type="xml">
        <form string="Promociones">
          <sheet>
            <div class="oe_title">
              <h1><field name="name"/></h1>
            </div>

            <group>
              <group>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
              </group>

              <group>
                <field name="combos_ids">
                  <list string="Combos" editable="bottom">
                    <field name="producto_id"/>
                    <field name="cantidad"/>
                    <field name="porcentaje_descuento"/>
                    <field name="productos_promocion_ids" widget="many2many_tags"/>
                  </list>
                </field>

                <field name="dosporuno_ids">
                  <list string="2x1" editable="bottom">
                    <field name="producto_id"/>
                    <field name="productos_promocion_ids" widget="many2many_tags"/>
                  </list>
                </field>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="quemen_promociones_view_search" model="ir.ui.view">
      <field name="name">quemen.promociones.search</field>
      <field name="model">quemen.promociones</field>
      <field name="arch" type="xml">
        <search string="Promociones">
          <field name="name"/>
          <field name="fecha_inicio"/>
          <field name="fecha_fin"/>
        </search>
      </field>
    </record>

    <record id="action_quemen_promociones" model="ir.actions.act_window">
      <field name="name">Promociones</field>
      <field name="res_model">quemen.promociones</field>
      <field name="view_mode">list,form</field>
      <field name="domain"></field>
      <field name="context"></field>
      <field name="search_view_id" ref="quemen_promociones_view_search"/>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">
          Click para crear una promo
        </p>
      </field>
    </record>

    <!-- =========================
         OP LOTE
    ========================== -->

    <record id="view_quemen_op_lote_form" model="ir.ui.view">
      <field name="name">quemen.op_lote.form</field>
      <field name="model">quemen.op_lote</field>
      <field name="arch" type="xml">
        <form string="Lote">
          <header>
            <button name="confirm_lot"
                    string="Confirmar"
                    class="oe_highlight"
                    type="object"
                    invisible="state != 'borrador'"/>
            <button name="create_lot"
                    string="Crear Lotes"
                    class="oe_highlight"
                    type="object"
                    invisible="state not in  ['borrador']"/>
            <button name="confirm_out"
                    string="Despacho"
                    class="oe_highlight"
                    type="object"
                    invisible="state not in ['borrador','confirmado']"/>
              
            <field name="state" widget="statusbar" statusbar_visible="borrador,confirmado"/>
          </header>

          <sheet>
            <div class="oe_title">
              <h1><field name="name"/></h1>
            </div>

            <group>
              <group>
                <field name="date" readonly="state == 'confirmado'"/>
                <field name="date_mrp_production" readonly="state == 'confirmado'"/>
                <field name="reference" readonly="state == 'confirmado'"/>
               <field name="despacho_id" readonly="True"/>
              </group>

              <field name="product_ids">
                <list string="Productos" editable="bottom">
                  <field name="lot_state" invisible="1"/>
                  <field name="product_id" readonly="lot_state == 'confirmado'"/>
                  <field name="quantity" readonly="lot_state == 'confirmado'"/>
                  <field name="elaboration_date"/>
                  <field name="lot_barcode_id" readonly="1"/>
                </list>
              </field>
            </group>

          </sheet>

            <chatter/>

        </form>
      </field>
    </record>

    <record id="view_quemen_op_loter_list" model="ir.ui.view">
      <field name="name">quemen.op_lote.list</field>
      <field name="model">quemen.op_lote</field>
      <field name="arch" type="xml">
        <list string="OP Lote" default_order="name desc">
          <field name="name"/>
          <field name="date"/>
          <field name="date_mrp_production"/>
          <field name="reference"/>
        </list>
      </field>
    </record>

    <record id="quemen_op_lote_view_search" model="ir.ui.view">
      <field name="name">quemen.op_lote.search</field>
      <field name="model">quemen.op_lote</field>
      <field name="arch" type="xml">
        <search string="Lotes">
          <field name="name"/>
          <field name="date"/>
          <field name="date_mrp_production"/>
        </search>
      </field>
    </record>

    <record id="action_quemen_produccion_lote" model="ir.actions.act_window">
      <field name="name">Orden de producción por lote</field>
      <field name="res_model">quemen.op_lote</field>
      <field name="view_mode">list,form</field>
      <field name="domain"></field>
      <field name="context"></field>
      <field name="search_view_id" ref="quemen_op_lote_view_search"/>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">
          Click para crear un lote
        </p>
      </field>
    </record>

    <!-- =========================
         PLANNING
    ========================== -->

    <record id="view_quemen_planning_form" model="ir.ui.view">
      <field name="name">quemen.planning.form</field>
      <field name="model">quemen.planning</field>
      <field name="arch" type="xml">
        <form string="Planeación">
          <header>
            <button name="show_components"
                    string="Calcular"
                    class="oe_highlight"
                    type="object"
                    invisible="state != 'borrador'"/>
            <button name="confirm_planning"
                    string="Confirmar"
                    class="oe_highlight"
                    type="object"
                    invisible="state != 'borrador'"/>
            <field name="state" widget="statusbar" statusbar_visible="borrador,confirmado"/>
          </header>

          <sheet>
            <div class="oe_title">
              <h1><field name="name"/></h1>
            </div>

            <group>
              <group>
                <field name="date" readonly="state == 'confirmado'"/>
                <field name="planning_date" readonly="state == 'confirmado'"/>
                <field name="reference" readonly="state == 'confirmado'"/>
              </group>

              <field name="product_ids">
                <list string="Productos" editable="bottom">
                  <field name="line_state" invisible="1"/>
                  <field name="product_id" readonly="line_state == 'confirmado'"/>
                  <field name="subproduct_id" readonly="line_state == 'confirmado'"/>
                  <field name="subproduct1_id" readonly="line_state == 'confirmado'"/>
                  <field name="subproduct2_id" readonly="line_state == 'confirmado'"/>
                  <field name="subproduct3_id" readonly="line_state == 'confirmado'"/>
                  <field name="subproduct4_id" readonly="line_state == 'confirmado'"/>
                  <field name="qty_production" readonly="line_state == 'confirmado'"/>
                  <field name="qty_stock" readonly="line_state == 'confirmado'"/>
                  <field name="qty" readonly="line_state == 'confirmado'"/>
                  <field name="area"/>
                </list>
              </field>
            </group>
          </sheet>

          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>

        </form>
      </field>
    </record>

    <record id="view_quemen_planning_list" model="ir.ui.view">
      <field name="name">quemen.planning.list</field>
      <field name="model">quemen.planning</field>
      <field name="arch" type="xml">
        <list string="Planeación">
          <field name="name"/>
          <field name="date"/>
          <field name="planning_date"/>
          <field name="reference"/>
        </list>
      </field>
    </record>

    <record id="quemen_planning_view_search" model="ir.ui.view">
      <field name="name">quemen.planning.search</field>
      <field name="model">quemen.planning</field>
      <field name="arch" type="xml">
        <search string="Lotes">
          <field name="name"/>
          <field name="date"/>
          <field name="planning_date"/>
        </search>
      </field>
    </record>

    <record id="action_quemen_planning" model="ir.actions.act_window">
      <field name="name">Orden de planeación</field>
      <field name="res_model">quemen.planning</field>
      <field name="view_mode">list,form</field>
      <field name="domain"></field>
      <field name="context"></field>
      <field name="search_view_id" ref="quemen_planning_view_search"/>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">
          Click para crear orden de planeación
        </p>
      </field>
    </record>

    <!-- =========================
         MENUS
    ========================== -->

    <menuitem
      id="menu_quemen_reporte_tiendas"
      name="Reportes de tienda"
      parent="point_of_sale.menu_point_root"
      sequence="75"
    />

    <menuitem
      id="menu_quemen_retiros"
      name="Retiros POS"
      action="action_quemen_retiros"
      parent="point_of_sale.menu_point_of_sale"
      sequence="75"
    />

    <menuitem
      id="menu_quemen_promociones"
      name="Promociones"
      action="action_quemen_promociones"
      parent="point_of_sale.menu_point_of_sale"
      sequence="100"
    />

    <menuitem
      id="menu_quemen_produccion_lote"
      name="Orden de producción por lote"
      action="action_quemen_produccion_lote"
      parent="mrp.menu_mrp_manufacturing"
      sequence="250"
    />

    <menuitem
      id="menu_quemen_planning"
      name="Planeación"
      action="action_quemen_planning"
      parent="mrp.menu_mrp_manufacturing"
      sequence="275"
    />

  </data>
</odoo>
