<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_reporte_retiros" model="ir.actions.report">
        <field name="name">Reporte de retiros</field>
        <field name="model">pos.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">quemen.reporte_retiros_sesion</field>
        <field name="report_file">quemen.reporte_retiros_sesion</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="quemen.paperformat_ticket"/>
    </record>

    <record id="view_quemen_reportes_retiro" model="ir.ui.view">
        <field name="name">Reporte de retiros wizard</field>
        <field name="model">quemen.reporte_retiros_sesion.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de retiros">
                <group string="Retiros">
                    <field name="retiro_id"/>
                </group>
                <footer>
                    <button name="print_report" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="quemen_action_reportes_retiro" model="ir.actions.act_window">
        <field name="name">Reporte retiros</field>
        <field name="res_model">quemen.reporte_retiros_sesion.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
    </record>

</odoo>
