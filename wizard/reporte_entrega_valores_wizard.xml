<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_quemen_entrega_valores_wizard" model="ir.ui.view">
            <field name="name">view.quemen.entrega_valores.wizard</field>
            <field name="model">quemen.reporte_entrega_valores.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte de entrega de valores">
                <group>
                    <field name="tienda_id"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                </group>
                <footer>
                    <button name="print_report" string="Generar reporte" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="quemen_action_reporte_entrega_valores" model="ir.actions.act_window">
            <field name="name">Reporte de entrega de valores</field>
            <field name="res_model">quemen.reporte_entrega_valores.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- MENU -->
        <menuitem
        id="entraga_valores"
        name="Entrega de valores"
        parent="quemen.menu_quemen_reporte_tiendas"
        action="quemen_action_reporte_entrega_valores"
        sequence="10"
        />

    </data>
</odoo>
