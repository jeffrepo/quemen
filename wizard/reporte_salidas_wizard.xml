<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_quemen_salidas_wizard" model="ir.ui.view">
            <field name="name">view.quemen.salidas.wizard</field>
            <field name="model">quemen.reporte_salidas.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte de existencias">
                    <group>
                        <field name="tienda_id"/>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                        <field name="tipo_operacion_id"/>
                    </group>
                    <footer>
                        <button name="print_report" string="Generar reporte" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- ACTION: definirlo como ir.actions.act_window -->
        <record id="quemen_action_reporte_salidas" model="ir.actions.act_window">
            <field name="name">Reporte de salidas</field>
            <field name="res_model">quemen.reporte_salidas.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>

            <!-- Si de verdad necesitas "binding" (acción contextual), usa binding_model_id -->
            <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
            <field name="binding_view_types">form</field>
        </record>

        <!-- MENU -->
        <menuitem id="menu_salidas"
                  parent="point_of_sale.menu_point_rep"
                  action="quemen_action_reporte_salidas"/>

    </data>
</odoo>
