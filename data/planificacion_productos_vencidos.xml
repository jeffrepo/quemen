<odoo>
  <record id="automatizacion_productos_vencidos" model="ir.cron">
    <field name="name">Verificación de productos vencidos</field>
    <field name="model_id" eval="ref('stock.model_stock_picking')"/>
    <field name="user_id" eval="ref('base.user_admin')"/>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True"/>
    <field name="priority">1</field>
    <field name="code">model.verificar_productos_vencidos()</field>
  </record>
</odoo>
