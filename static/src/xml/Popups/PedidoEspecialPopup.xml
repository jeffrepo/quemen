<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="quemen.PedidoEspecialPopup">
        <Dialog title="props.title" size="'md'">
            <div class="d-flex flex-column gap-3">
                <div>
                    <label class="form-label fw-semibold">Fecha de entrega</label>
                    <input class="form-control form-control-lg" type="date" t-model="state.fecha"/>
                </div>
                <div>
                    <label class="form-label fw-semibold">Hora de entrega</label>
                    <input class="form-control form-control-lg" type="time" t-model="state.hora"/>
                </div>
                <div>
                    <label class="form-label fw-semibold">Observaciones</label>
                    <textarea class="form-control form-control-lg" rows="4" t-model="state.observaciones"/>
                </div>
                <div>
                    <label class="form-label fw-semibold">Sucursal de entrega</label>
                    <input class="form-control form-control-lg" t-model="state.sucursal_entrega"/>
                </div>
                <div>
                    <label class="form-label fw-semibold">Autorizó</label>
                    <input class="form-control form-control-lg" t-model="state.autorizo"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg" t-att-disabled="!isValid" t-on-click="confirm">
                    Confirmar
                </button>
                <button class="btn btn-secondary btn-lg" t-on-click="cancel">
                    Cancelar
                </button>
            </t>
        </Dialog>
    </t>
</templates>
