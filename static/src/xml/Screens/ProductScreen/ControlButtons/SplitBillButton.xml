<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="quemen.PedidoEspecialButton"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('more-btn')]" position="before">
            <button t-if="!props.showRemainingButtons"
                    t-att-disabled="currentOrder?.isEmpty()"
                    t-att-class="buttonClass"
                    t-on-click="() => this.clickPedidoEspecial()">
                <i class="fa fa-file-text-o me-1" role="img" aria-label="Pedido especial" title="Pedido especial"/>
                Pedido especial
            </button>
        </xpath>
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-att-class="buttonClass"
                    t-att-disabled="currentOrder?.isEmpty()"
                    t-on-click="() => this.clickPedidoEspecial()">
                <i class="fa fa-file-text-o me-1" role="img" aria-label="Pedido especial" title="Pedido especial"/>
                Pedido especial
            </button>
        </xpath>
    </t>
</templates>
